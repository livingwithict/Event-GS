{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "REPLACE_WITH_FIGMA_PERSONAL_ACCESS_TOKEN"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
